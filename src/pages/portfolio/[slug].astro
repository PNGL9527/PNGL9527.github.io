---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import type { LanguageKey } from '@/i18n/i18n.ts';
import { Image } from 'astro:assets';
import ProjectCard from '../../components/ProjectCard.astro';
import FloatingTOC from '@/components/FloatingTOC.astro';
import ProjectTitle from '@/components/ProjectTitle.astro';
import { selectRelatedProjects } from '@/utility/related-projects';


/* ---------------- getStaticPaths ---------------- */
export async function getStaticPaths() {
  const projects = await getCollection('project', (p) => !p.data.draft && p.id.startsWith('en/'));

  return projects.map((project) => ({
    params: { slug: project.id.slice('en/'.length) },
  }));
}

/* ---------------- Page data ---------------- */
const currentLocale: LanguageKey = 'en';
const slug = String(Astro.params.slug ?? '');

const projects = await getCollection(
  'project',
  (p) => !p.data.draft && p.id.startsWith(`${currentLocale}/`),
);

const project = projects.find((p) => p.id === `${currentLocale}/${slug}`);
if (!project) throw new Error(`Project not found: ${currentLocale}/${slug}`);

/* ---------------- Mapping ---------------- */
const typeLabel = project.data.type ?? '';

const typeToIcon: Record<string, string> = {
  Research: 'material-symbols:science-outline',
  Tool: 'material-symbols:build-outline',
  Product: 'material-symbols:widgets-outline',
  Service: 'material-symbols:handshake-outline',
  Strategy: 'material-symbols:strategy',
  Prototype: 'material-symbols:biotech-outline',
  Spatial: 'material-symbols:architecture',
  Teaching: 'material-symbols:school-outline',
  Experiment: 'material-symbols:experiment-outline',
};

const typeIcon = typeToIcon[typeLabel] ?? 'material-symbols:apps';

/* ---------------- Content ---------------- */

const caseUrl: string = project.data.caseUrl ?? '';
const cover = project.data.thumbnail ?? null;
const coverAlt = project.data.thumbnailAlt ?? project.data.title;
const summary = project.data.description ?? project.data.context ?? '';

const highlightsRaw = Array.isArray(project.data.highlights)
  ? project.data.highlights
  : [];
const highlights = highlightsRaw
  .map((h: any) => (typeof h === 'string' ? h : h?.text ?? ''))
  .filter(Boolean);

const { Content, headings } = await render(project);
const sections = headings.filter((heading) => heading.depth === 2);

/* ---------------- More selected work (logic) ---------------- */
const relatedProjects = selectRelatedProjects(project, projects);

// 返回到 Selected work 列表页
const backToWorkHref = '/portfolio';
---

<style>

  /* ---------- CTA buttons ---------- */
  :global(.case-btn) {
    border: 1px solid rgba(0, 0, 0, 0.25);
    background: transparent;
    transition: background 0.15s ease, color 0.15s ease;
  }

  @media (hover: hover) {
    :global(.case-btn:hover) {
      background: #111;
      color: white;
    }
  }

  @media (hover: none) {
    :global(.case-btn) {
      background: #111;
      color: white;
    }
  }

  /* ---------- MDX media ---------- */
  :global(.case-prose) { overflow-wrap: anywhere; }
  :global(.case-prose h2) { margin-top: 4rem; scroll-margin-top: 2rem; }
  :global(.case-prose h3) { scroll-margin-top: 2rem; }
  :global(.case-prose > h2:first-child) { margin-top: 0; }
  :global(.case-prose .case-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
  :global(.case-prose .case-grid > *) { min-width: 0; }
  :global(.case-prose .case-grid-three) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  :global(.case-prose .case-grid.case-align-bottom) { grid-template-rows: auto auto; row-gap: .7rem; align-items: stretch; }
  :global(.case-prose .case-align-bottom > figure) { display: grid; grid-row: span 2; grid-template-rows: subgrid; }
  :global(.case-prose .case-align-bottom .image-trigger) { align-self: end; }
  :global(.case-prose .case-align-bottom figcaption) { margin-top: 0; }
  :global(.case-prose .case-images-center .image-trigger) { align-self: center; }
  :global(.case-prose figure.case-image .image-trigger img.case-pair-reference-size) { width: calc(46% - .69rem); margin-inline: auto; }
  :global(.case-prose .case-steps-equal) { align-items: stretch; row-gap: .7rem; }
  :global(.case-prose .case-steps-equal > section) { display: grid; grid-row: span 4; grid-template-rows: subgrid; }
  :global(.case-prose .case-steps-equal > section > h3) { margin: 1.5rem 0 .7rem; }
  :global(.case-prose .case-steps-equal .case-image) { display: grid; grid-row: span 2; grid-template-rows: subgrid; margin: 0; }
  :global(.case-prose .case-steps-equal .image-trigger) { align-self: stretch; display: flex; align-items: center; background: white; }
  :global(.case-prose .case-steps-equal .image-trigger img.case-helper-scale) { width: 92%; margin-inline: auto; }
  :global(.case-prose .case-steps-equal figcaption) { margin-top: 0; }
  :global(.case-prose .case-steps-equal > section > p) { margin: .7rem 0 1.5rem; }
  :global(.case-prose .case-evidence) { margin: 2rem 0; }
  :global(.case-prose .case-table-scroll) { overflow-x: auto; margin: 2rem 0; border: 1px solid #ddd; border-radius: 1rem; }
  :global(.case-prose .case-table-scroll:focus-visible) { outline: 3px solid #ffa808; outline-offset: 3px; }
  :global(.case-prose .case-persona-table) { min-width: 42rem; border-collapse: collapse; font-size: .95rem; line-height: 1.6; margin: 0; }
  :global(.case-prose .case-persona-table caption) { text-align: left; font-weight: 600; padding: 1rem; background: #fafafa; }
  :global(.case-prose .case-persona-table th), :global(.case-prose .case-persona-table td) { text-align: left; vertical-align: top; padding: 1rem; border-bottom: 1px solid #ddd; border-right: 1px solid #eee; }
  :global(.case-prose .case-persona-table th:first-child) { width: 18%; }
  :global(.case-prose .case-persona-table tbody th) { background: #fafafa; font-weight: 500; }
  :global(.case-prose .case-persona-table .case-image) { margin: 0; }
  :global(.case-prose .case-persona-table .image-trigger) { background: transparent; }
  :global(.case-prose .case-persona-table tr:last-child > *) { border-bottom: 0; }
  :global(.case-prose .case-actions) { display: flex; flex-wrap: wrap; gap: .75rem; margin: 2rem 0; }
  :global(.case-prose .case-actions a) { white-space: normal; text-align: center; }
  :global(.case-prose details) { border: 1px solid #0002; border-radius: 1rem; padding: 1.2rem; margin: 1.75rem 0; }
  :global(.case-prose summary) { cursor: pointer; font-weight: 600; }
  :global(.case-prose .case-prototype) { border: 1px solid #0002; border-radius: 1rem; padding: 1rem; }
  :global(.case-prose .case-prototype h3) { font-size: 1rem; margin: 0 0 1rem; }
  :global(.case-prose .case-prototype iframe) { width: 100%; aspect-ratio: 9 / 16; border: 0; border-radius: .75rem; }
  :global(.case-prose .case-prototype a) { display: inline-block; margin-top: 1rem; text-decoration: underline; }
  :global(.case-prose table) { width: 100%; table-layout: fixed; }
  :global(.case-prose td), :global(.case-prose th) { overflow-wrap: anywhere; padding-right: .6rem; }
  @media (max-width: 40rem) {
    :global(.case-prose figure.case-image .image-trigger img.case-pair-reference-size) { width: 92%; }
    :global(.case-prose .case-grid) { grid-template-columns: minmax(0, 1fr); }
    :global(.case-prose .case-steps-equal > section), :global(.case-prose .case-steps-equal .case-image) { display: block; grid-row: auto; }
    :global(.case-prose .case-steps-equal figcaption) { margin-top: .7rem; }
    :global(.case-prose .case-grid.case-align-bottom) { grid-template-rows: none; row-gap: 1.5rem; }
    :global(.case-prose .case-align-bottom > figure) { display: block; grid-row: auto; }
    :global(.case-prose .case-align-bottom figcaption) { margin-top: .7rem; }
  }
</style>

<Base title={project.data.title} description={project.data.description} socialImage={typeof cover === 'string' ? cover : undefined}>
  <main>
    <div class="mx-auto w-full max-w-[56rem] px-6">
      <!-- ================= Hero ================= -->
      <section class="pt-[var(--navbar-height)]">
        {typeLabel && (
          <div class="mb-6">
            <span class="inline-flex flex-wrap items-center gap-2 text-sm font-normal text-primary-900">
              <Icon name={typeIcon} size={18} />
              {typeLabel}
              {project.data.year && <span class="text-primary-500">· {project.data.year}</span>}
              {project.data.status !== 'completed' && (
                <span class="capitalize text-primary-500">· {project.data.status}</span>
              )}
            </span>
          </div>
        )}

        <h1
          class="
            text-3xl
            sm:text-4xl
            md:text-5xl
            lg:text-6xl
            font-semibold
            leading-[1.25]
            sm:leading-[1.2]
            md:leading-[1.15]
            lg:leading-[1.1]
            tracking-tight
          "
        >
          <ProjectTitle project={project} />
        </h1>

        <!-- Cover -->
        <div
          class="
            mt-8 w-full overflow-hidden rounded-3xl border border-black/10 bg-black/5
          "
          style={{ aspectRatio: project.data.coverAspectRatio }}
        >
          {cover &&
            (typeof cover === 'string' ? (
              <img src={cover} alt={coverAlt} class="h-full w-full object-cover" style={{ objectPosition: project.data.coverPosition }} />
            ) : (
              <Image src={cover} alt={coverAlt} class="h-full w-full object-cover" style={{ objectPosition: project.data.coverPosition }} />
            ))}
        </div>
      </section>
   
<!-- ================= Overview ================= -->
      <section class="mt-12">
        <div class="space-y-10">
          <div>
            {summary && <p class="text-lg leading-relaxed text-primary-700">{summary}</p>}

            {project.data.contribution && (
              <div class="mt-8 rounded-2xl bg-black/5 p-5">
                <div class="text-sm font-semibold">My contribution</div>
                <p class="mt-2 text-sm leading-relaxed text-primary-700">
                  {project.data.contribution}
                </p>
              </div>
            )}

            {highlights.length > 0 && (
              <div class="mt-10">
                <div class="text-base font-semibold">Project snapshot</div>
                <ul class="mt-4 space-y-2 text-sm text-primary-700">
                  {highlights.map((h) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-1.5 w-1.5 rounded-full bg-black/40"></span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>


      <FloatingTOC sections={sections} />

      <!-- ================= Body ================= -->
      <section class="mt-12">
        <div class="case-prose prose prose-zinc max-w-none">
          <Content />
        </div>

        <!-- Read full case: moved to the very end of the body -->

{caseUrl && (
  <div class="mt-12 flex flex-col items-center gap-4 text-center">
    <p class="max-w-[36rem] text-sm leading-relaxed text-neutral-500">
      <em>
        Additional project documentation is available on Notion.
      </em>
    </p>

    <a
      href={caseUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="case-btn inline-flex items-center justify-center rounded-full px-5 py-3 font-semibold md:w-auto w-full"
    >
      View project archive
      <Icon name="material-symbols:open-in-new-rounded" size={18} />
    </a>
  </div>
)}

      </section>

      <!-- ================= More selected work ================= -->
      {relatedProjects.length > 0 && (
        <section class="mt-16 md:mt-20">
          <div class="flex items-start justify-between gap-6">
            <h2 class="text-xl sm:text-2xl font-semibold tracking-tight">
              Continue exploring
            </h2>

            <!-- Desktop button: on the right -->
            <a
              href={backToWorkHref}
              class="case-btn hidden md:inline-flex items-center justify-center rounded-full px-5 py-3 font-semibold"
            >
              View all projects
            </a>
          </div>

          <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
            {relatedProjects.map((p) => (
              <ProjectCard project={p} />
            ))}
          </div>

          <!-- Mobile button: full-width button AFTER the two cards -->
          <div class="mt-6 md:hidden">
            <a
              href={backToWorkHref}
              class="case-btn inline-flex w-full items-center justify-center rounded-full px-6 py-5 font-semibold"
            >
              View all projects
            </a>
          </div>
        </section>
      )}

      <div class="h-24"></div>
    </div>
  </main>
</Base>

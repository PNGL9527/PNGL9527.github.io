---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { LanguageKey } from '@/i18n/i18n.ts';

const currentLocale: LanguageKey = 'en';
const projects = await getCollection(
  'project',
  (project) => !project.data.draft && project.id.startsWith(`${currentLocale}/`),
);

const sortedProjects = projects.sort((a, b) => {
  const orderDifference = a.data.featuredOrder - b.data.featuredOrder;
  if (orderDifference !== 0) return orderDifference;
  return b.data.publishDate.getTime() - a.data.publishDate.getTime();
});

const filters = [
  { id: 'all', label: 'All work', icon: 'material-symbols:apps' },
  { id: 'research-tools', label: 'Research & Tools', icon: 'material-symbols:science-outline' },
  { id: 'design-practice', label: 'Design Practice', icon: 'material-symbols:design-services-outline' },
  {
    id: 'teaching-experiments',
    label: 'Teaching & Experiments',
    icon: 'material-symbols:experiment-outline',
  },
] as const;

const sectionLabels: Record<string, string> = {
  'research-tools': 'Research & Tools',
  'design-practice': 'Design Practice',
  'teaching-experiments': 'Teaching & Experiments',
};
---

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const filterRoot = document.querySelector('[data-portfolio-filters]');
    const projectRoot = document.querySelector('[data-projects]');

    filterRoot?.addEventListener('click', (event) => {
      const button = event.target?.closest?.('button[data-section-filter]');
      if (!button) return;

      const selectedSection = button.dataset.sectionFilter;

      filterRoot.querySelectorAll('button[data-section-filter]').forEach((candidate) => {
        const isActive = candidate.dataset.sectionFilter === selectedSection;
        candidate.classList.toggle('bg-primary-900', isActive);
        candidate.classList.toggle('text-white', isActive);
        candidate.classList.toggle('hover:bg-primary-100', !isActive);
        candidate.setAttribute('aria-pressed', String(isActive));
      });

      projectRoot?.querySelectorAll('[data-project-section]').forEach((project) => {
        const isVisible = selectedSection === 'all' || project.dataset.projectSection === selectedSection;
        project.classList.toggle('hidden', !isVisible);
      });
    });
  });
</script>

<Base
  title="Portfolio"
  description="Selected research, tools, service design, spatial practice, teaching, and experiments by Peng Lu."
>
  <main>
    <div class="mx-auto w-full max-w-screen-xl px-6">
      <section class="pt-[var(--navbar-height)]">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-500">Portfolio</p>
        <h1 class="mt-5 max-w-4xl text-4xl font-semibold leading-tight tracking-tight md:text-6xl">
          Research translated into tools, systems, and experiences.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-primary-700 md:text-xl">
          Selected work across design research, service and spatial practice, teaching, and independent
          computational experiments.
        </p>
      </section>

      <section class="mt-12" aria-label="Filter portfolio projects">
        <ul class="flex flex-wrap gap-2" data-portfolio-filters>
          {filters.map((filter, index) => (
            <li>
              <button
                type="button"
                data-section-filter={filter.id}
                aria-pressed={index === 0 ? 'true' : 'false'}
                class:list={[
                  'inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm transition-colors',
                  index === 0 ? 'bg-primary-900 text-white' : 'hover:bg-primary-100',
                ]}
              >
                <Icon name={filter.icon} size={20} />
                {filter.label}
              </button>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-16">
        <ul data-projects class="flex flex-col gap-16 md:gap-24">
          {sortedProjects.map((project) => {
            const slug = project.id.slice(currentLocale.length + 1);
            const href = `/portfolio/${slug}/`;
            const projectSection = project.data.section;
            const visibleTags = project.data.tags.slice(0, 3);

            return (
              <li
                data-project-section={projectSection}
                class="grid grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12"
              >
                <a
                  href={href}
                  class="group block aspect-[16/9] w-full overflow-hidden rounded-2xl border border-black/10 bg-black/5"
                >
                  {project.data.thumbnail &&
                    (typeof project.data.thumbnail === 'string' ? (
                      <img
                        src={project.data.thumbnail}
                        alt={project.data.thumbnailAlt ?? project.data.title}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                        loading="lazy"
                      />
                    ) : (
                      <Image
                        src={project.data.thumbnail}
                        alt={project.data.thumbnailAlt ?? project.data.title}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                        loading="lazy"
                      />
                    ))}
                </a>

                <div class="flex max-w-prose flex-col md:py-2">
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-primary-500">
                    <span>{sectionLabels[projectSection]}</span>
                    {project.data.year && <span>{project.data.year}</span>}
                    {project.data.status !== 'completed' && (
                      <span class="capitalize">{project.data.status}</span>
                    )}
                  </div>

                  <h2 class="mt-4 text-2xl font-semibold leading-snug md:text-3xl">
                    <a href={href} class="hover:underline hover:underline-offset-4">{project.data.title}</a>
                  </h2>
                  <p class="mt-4 text-lg leading-relaxed text-primary-700">{project.data.description}</p>

                  {project.data.contribution && (
                    <p class="mt-5 border-l-2 border-black/15 pl-4 text-sm leading-relaxed text-primary-700">
                      <span class="font-semibold text-primary-900">My contribution:</span>{' '}
                      {project.data.contribution}
                    </p>
                  )}

                  {visibleTags.length > 0 && (
                    <ul class="mt-6 flex flex-wrap gap-2">
                      {visibleTags.map((tag) => (
                        <li class="rounded-full bg-black/5 px-3 py-1 text-xs text-primary-700">{tag}</li>
                      ))}
                    </ul>
                  )}

                  <div class="mt-7 md:mt-auto md:pt-8">
                    <a href={href} class="btn-pill w-full md:w-auto">
                      View project
                      <Icon name="material-symbols:arrow-forward-rounded" size={18} />
                    </a>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </section>

      <div class="h-24"></div>
    </div>
  </main>
</Base>

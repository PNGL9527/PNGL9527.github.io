---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { LanguageKey } from '@/i18n/i18n.ts';
import { comparePortfolioItems } from '@/utility/portfolio-sort';
import ProjectTitle from '@/components/ProjectTitle.astro';

const currentLocale: LanguageKey = 'en';
const projects = await getCollection(
  'project',
  (project) => !project.data.draft && project.id.startsWith(`${currentLocale}/`),
);

const sortedProjects = projects.sort((a, b) => comparePortfolioItems(
  { id: a.id, type: a.data.type, year: a.data.year, order: a.data.featuredOrder },
  { id: b.id, type: b.data.type, year: b.data.year, order: b.data.featuredOrder },
  'type',
));

const filters = [
  { id: 'all', label: 'All work', icon: 'material-symbols:apps' },
  { id: 'research-tools', label: 'Research & Tools', icon: 'material-symbols:science-outline' },
  { id: 'design-practice', label: 'Design Practice', icon: 'material-symbols:design-services-outline' },
  {
    id: 'teaching-experiments',
    label: 'Teaching & Experiments',
    icon: 'material-symbols:experiment-outline',
  },
] as const;

---

<script>
  import { comparePortfolioItems, type PortfolioSortMode } from '@/utility/portfolio-sort';

  document.addEventListener('astro:page-load', () => {
    const filterRoot = document.querySelector('[data-portfolio-filters]');
    const projectRoot = document.querySelector<HTMLElement>('[data-projects]');
    const sortRoot = document.querySelector('[data-portfolio-sort]');
    if (!projectRoot || projectRoot.dataset.initialized) return;
    projectRoot.dataset.initialized = 'true';

    filterRoot?.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('button[data-section-filter]') : null;
      if (!button) return;

      const selectedSection = button.dataset.sectionFilter;

      filterRoot.querySelectorAll<HTMLButtonElement>('button[data-section-filter]').forEach((candidate) => {
        const isActive = candidate.dataset.sectionFilter === selectedSection;
        candidate.classList.toggle('bg-primary-900', isActive);
        candidate.classList.toggle('text-white', isActive);
        candidate.classList.toggle('hover:bg-primary-100', !isActive);
        candidate.setAttribute('aria-pressed', String(isActive));
      });

      projectRoot.querySelectorAll<HTMLElement>('[data-project-section]').forEach((project) => {
        const isVisible = selectedSection === 'all' || project.dataset.projectSection === selectedSection;
        project.classList.toggle('hidden', !isVisible);
      });
    });

    sortRoot?.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-project-sort]') : null;
      if (!button) return;
      const mode: PortfolioSortMode = button.dataset.projectSort === 'date' ? 'date' : 'type';
      const cards = [...projectRoot.querySelectorAll<HTMLElement>(':scope > [data-project-section]')];
      const key = (card: HTMLElement) => ({
        id: card.dataset.projectId ?? '',
        type: card.dataset.projectType,
        year: card.dataset.projectYear,
        order: Number(card.dataset.projectOrder ?? 999),
      });
      cards.sort((a, b) => comparePortfolioItems(key(a), key(b), mode));
      projectRoot.append(...cards);
      sortRoot.querySelectorAll<HTMLElement>('[data-project-sort]').forEach((candidate) => {
        const active = candidate.dataset.projectSort === mode;
        candidate.setAttribute('aria-pressed', String(active));
        candidate.classList.toggle('bg-primary-900', active);
        candidate.classList.toggle('text-white', active);
      });
      document.querySelector('[data-sort-date-note]')?.classList.toggle('hidden', mode !== 'date');
      const status = document.querySelector('[data-sort-status]');
      if (status) status.textContent = mode === 'date' ? 'Projects sorted newest first by project year.' : 'Projects grouped by type.';
    });
  });
</script>

<Base
  title="Portfolio"
  description="Selected research, tools, service design, spatial practice, teaching, and experiments by Peng Lu."
>
  <main>
    <div class="mx-auto w-full max-w-screen-xl px-6">
      <section class="pt-[var(--navbar-height)]">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-500">Portfolio</p>
        <h1 class="mt-5 max-w-4xl text-4xl font-semibold leading-tight tracking-tight md:text-6xl">
          Research translated into tools, systems, and experiences.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-primary-700 md:text-xl">
          Selected work across design research, service and spatial practice, teaching, and independent
          computational experiments.
        </p>
      </section>

      <section class="mt-12" aria-label="Filter portfolio projects">
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
        <ul class="flex flex-wrap gap-2" data-portfolio-filters>
          {filters.map((filter, index) => (
            <li>
              <button
                type="button"
                data-section-filter={filter.id}
                aria-pressed={index === 0 ? 'true' : 'false'}
                class:list={[
                  'inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm transition-colors',
                  index === 0 ? 'bg-primary-900 text-white' : 'hover:bg-primary-100',
                ]}
              >
                <Icon name={filter.icon} size={20} />
                {filter.label}
              </button>
            </li>
          ))}
        </ul>
        <div class="ml-auto flex shrink-0 rounded-full border border-black/10 bg-black/[0.03] p-1" data-portfolio-sort role="group" aria-label="Sort projects">
          <button type="button" data-project-sort="type" aria-pressed="true" class="rounded-full bg-primary-900 px-4 py-2 text-sm text-white transition-colors">By type</button>
          <button type="button" data-project-sort="date" aria-pressed="false" class="rounded-full px-4 py-2 text-sm transition-colors">By date</button>
        </div>
        </div>
        <p class="mt-3 hidden text-right text-xs text-primary-500" data-sort-date-note>Newest first · Date ranges use their end year.</p>
        <p class="sr-only" aria-live="polite" data-sort-status></p>
      </section>

      <section class="mt-16">
        <ul data-projects class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:gap-x-10 lg:gap-y-16">
          {sortedProjects.map((project) => {
            const slug = project.id.slice(currentLocale.length + 1);
            const href = `/portfolio/${slug}/`;
            const projectSection = project.data.section;
            const visibleTags = project.data.tags.slice(0, 3);

            return (
              <li
                data-project-section={projectSection}
                data-project-id={project.id}
                data-project-type={project.data.type}
                data-project-year={project.data.year ?? ''}
                data-project-order={project.data.featuredOrder}
                class="flex min-w-0 flex-col"
              >
                <a
                  href={href}
                  class="group block aspect-[2/1] w-full shrink-0 overflow-hidden rounded-2xl border border-black/10 bg-black/5"
                >
                  {project.data.thumbnail &&
                    (typeof project.data.thumbnail === 'string' ? (
                      <img
                        src={project.data.thumbnail}
                        alt={project.data.thumbnailAlt ?? project.data.title}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                        loading="lazy"
                      />
                    ) : (
                      <Image
                        src={project.data.thumbnail}
                        alt={project.data.thumbnailAlt ?? project.data.title}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                        loading="lazy"
                      />
                    ))}
                </a>

                <div class="flex flex-1 flex-col pt-5">
                  <h2 class="text-xl font-semibold leading-snug md:text-2xl">
                    <a href={href} class="hover:underline hover:underline-offset-4"><ProjectTitle project={project} /></a>
                  </h2>

                  {visibleTags.length > 0 && (
                    <ul class="mt-4 flex flex-wrap gap-2">
                      {visibleTags.map((tag) => (
                        <li class="rounded-full bg-black/5 px-3 py-1 text-xs text-primary-700">{tag}</li>
                      ))}
                    </ul>
                  )}

                </div>
              </li>
            );
          })}
        </ul>
      </section>

      <div class="h-24"></div>
    </div>
  </main>
</Base>

---
import Base from '@/layouts/Base.astro';
import Banner from '@/components/Banner.astro';
import { languages, useTranslations, type LanguageKey } from '@/i18n/i18n.ts';
import { getRelativeLocaleUrl } from 'astro:i18n';

const currentLocale = Astro.currentLocale as LanguageKey;
const t = useTranslations(currentLocale);

export function getStaticPaths() {
  return Object.keys(languages).map((language) => ({
    params: { language },
  }));
}

// ✅ localized work url, e.g. /en/work/
const workUrl = getRelativeLocaleUrl(currentLocale, 'work');
---

<Base title={t('Navbar-1')}>
  <main class="md:min-h-screen min-h-auto">
    <Banner>
      <h1 class="px-4 font-semibold">
        <span class="block text-3xl md:text-6xl leading-tight">
          {t('Hero-1', { name: t('Me-1') })}
        </span>

        <span class="block mt-4 md:mt-6 text-3xl md:text-6xl leading-tight">
          {t('Hero-2')}
        </span>

        <span class="block mt-6 md:mt-8 text-2xl md:text-4xl font-normal">
          {t('Hero-3')}
        </span>

        <span class="block mt-6 md:mt-8">
          <a
            href={workUrl}
            class="highlight inline-block mt-8 text-lg md:text-xl font-semibold leading-none"
          >
            View selected work.
          </a>
        </span>
      </h1>
    </Banner>

    <section class="mb-16 mx-4">
      <div class="h-px w-full opacity-20"></div>
    </section>
  </main>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Banner from '@/components/Banner.astro';
import { Icon } from 'astro-icon/components';
import { languages, useTranslations, type LanguageKey } from '@/i18n/i18n.ts';

const currentLocale = Astro.currentLocale as LanguageKey;
const t = useTranslations(currentLocale);

const publicCurrentLangProjects = await getCollection('project', (project) => {
  const isPublicProject = !project.data.draft;
  const isCurrentLangProject = project.id.startsWith(currentLocale);
  return isPublicProject && isCurrentLangProject;
});

const sortedProjects = publicCurrentLangProjects.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

// 用于项目内展示 tags（不用于过滤）
const allProjectTags = publicCurrentLangProjects
  .reduce<string[]>((acc, curr) => {
    const tags = curr.data.tags || [];
    return [...new Set([...acc, ...tags])];
  }, [])
  .sort((a, b) => a.localeCompare(b));

type ProjectTypeId =
  | 'All'
  | 'Research'
  | 'Product'
  | 'Service'
  | 'Strategy'
  | 'Prototype'
  | 'Writing';

type ProjectType = {
  id: ProjectTypeId;
  label: string;
  icon: string;
};

const allProjectTypes: ProjectType[] = [
  { id: 'All', label: 'All', icon: 'material-symbols:apps' },
  { id: 'Research', label: 'Research', icon: 'material-symbols:science-outline' },
  { id: 'Product', label: 'Product / UX', icon: 'material-symbols:widgets-outline' },
  { id: 'Service', label: 'Service / System', icon: 'material-symbols:account-tree-outline' },
  { id: 'Strategy', label: 'Strategy', icon: 'material-symbols:target' },
  { id: 'Prototype', label: 'Prototype', icon: 'material-symbols:rocket-launch-outline' },
  { id: 'Writing', label: 'Writing', icon: 'material-symbols:article-outline' },
];

export function getStaticPaths() {
  return Object.keys(languages).map((language) => ({
    params: { language },
  }));
}
---

<style is:inline>
  .active {
    background-color: var(--color-primary-900);
    color: var(--color-primary-50);
    border-color: transparent;
  }
</style>

<script is:inline define:vars={{ allProjectTypes }}>
  document.addEventListener('astro:page-load', () => {
    let activeType = 'All';

    const typeFilterElement = document.querySelector('[data-type-filter]');
    const worksElement = document.querySelector('[data-works]');

    function updateList() {
      // Type buttons active state
      typeFilterElement?.querySelectorAll('button').forEach((button) => {
        button.classList.toggle('active', button.dataset.type === activeType);
      });

      // Cards visibility
      worksElement?.querySelectorAll('[data-type]').forEach((card) => {
        const type = card.dataset.type || '';
        const visible = activeType === 'All' || type === activeType;
        card.classList.toggle('hidden', !visible);
      });
    }

    typeFilterElement?.addEventListener('click', (e) => {
      const button = e.target?.closest?.('button');
      if (!button) return;

      activeType = button.dataset.type || 'All';
      updateList();
    });

    updateList();
  });
</script>

<Base title={t('Navbar-3')}>
  <main>
    <div class="container mx-auto">
      <!-- Title: aligned with homepage via Banner -->
      <Banner>
        <h1 class="px-4 font-semibold">
          <span class="block text-3xl md:text-6xl leading-tight">Selected Work</span>
        </h1>
      </Banner>

      <!-- Filters + Works -->
      <!-- 这里 mt-6 是让标题下面内容“跟着一起上提”，你可改 mt-4/mt-8 -->
      <section class="mt-6 px-4 flex flex-col gap-10">
        <!-- Project type filter (icon + label) -->
        <ul class="flex flex-wrap gap-2" data-type-filter>
          {allProjectTypes.map((type) => (
            <li>
              <button
                data-type={type.id}
                type="button"
                class="border-2 py-2 px-4 border-primary-50 rounded-full inline-flex items-center gap-3 transition-colors whitespace-nowrap hover:bg-primary-100"
              >
                <Icon size={22} name={type.icon} />
                <span class="text-sm md:text-base">{type.label}</span>
              </button>
            </li>
          ))}
        </ul>

        <!-- Project list -->
        <ul data-works class="flex flex-col gap-16">
          {sortedProjects.map((project) => {
            const id = String(project.id ?? '');
            const normalizedSlug = id.startsWith(`${currentLocale}/`)
              ? id.slice(currentLocale.length + 1)
              : id.split('/').slice(1).join('/');

            const tags = project.data.tags ?? [];
            const projectType = project.data.type ?? 'Research';

            return (
              <li
                data-type={projectType}
                data-tags={tags.join(',')}
                class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-12 items-stretch"
              >
                {/* Left: image */}
                {project.data.thumbnail ? (
                  <div class="w-full aspect-[4/3] overflow-hidden rounded-2xl border border-black/10 bg-black/5">
                    <img
                      src={project.data.thumbnail}
                      alt={project.data.thumbnailAlt ?? project.data.title}
                      class="h-full w-full object-cover"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <div class="w-full aspect-[4/3] rounded-2xl border border-black/10 bg-black/5" />
                )}

                {/* Right: content with equal top/bottom spacing on wide screens */}
                <div class="flex h-full flex-col md:py-12 py-8">
                  <div class="flex flex-col gap-4">
                    <h3 class="text-xl md:text-2xl font-medium leading-snug">
                      {project.data.title}
                      <time class="opacity-60"> — {project.data.publishDate.getFullYear()}</time>
                    </h3>

                    {project.data.context && <p class="text-sm opacity-70">{project.data.context}</p>}

                    <p class="text-base">{project.data.description}</p>

                    {tags.length > 0 && (
                      <div class="flex flex-wrap gap-2 pt-1">
                        {tags.map((tag) => (
                          <span class="border border-primary-100 px-3 py-1 rounded-full text-xs">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>

                  {/* CTA pinned to bottom; with minimum spacing to avoid sticking to tags on narrower widths */}
                  <div class="mt-auto pt-6 md:pt-8">
                    <a
                      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/${currentLocale}/work/${normalizedSlug}/`}
                      class="highlight text-base md:text-lg font-medium inline-block"
                    >
                      View overview →
                    </a>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </section>

      <div class="h-20"></div>
    </div>
  </main>
</Base>

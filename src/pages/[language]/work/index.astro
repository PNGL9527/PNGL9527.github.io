import { defineCollection, z } from 'astro:content';

const project = defineCollection({
  type: 'content',
  schema: z.object({
    title: z.string(),
    description: z.string(),
    publishDate: z.coerce.date(),
    draft: z.boolean().default(false),

    // Keep existing constraints in your repo (may be enum-based elsewhere)
    tech: z.array(z.string()).default([]),

    // ✅ Research / method / theme tags (free text)
    tags: z.array(z.string()).default([]),

    // Optional metadata for cards & overview page
    context: z.string().optional(),
    role: z.string().optional(),
    highlights: z.array(z.string()).default([]),

    thumbnail: z
      .object({
        src: z.string(),
        alt: z.string().default('Project thumbnail'),
      })
      .optional(),

    // Long-form case (e.g., Notion)
    caseUrl: z.string().url().optional(),

    // External landing page (optional)
    externalUrl: z.string().url().optional(),
  }),
});

export const collections = { project };

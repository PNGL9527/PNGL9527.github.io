---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { languages, useTranslations, type LanguageKey } from '@/i18n/i18n.ts';

const currentLocale = Astro.currentLocale as LanguageKey;
const t = useTranslations(currentLocale);

const publicCurrentLangProjects = await getCollection('project', (project) => {
  const isPublicProject = !project.data.draft;
  const isCurrentLangProject = project.id.startsWith(currentLocale);
  return isPublicProject && isCurrentLangProject;
});

const sortedProjects = publicCurrentLangProjects.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

type TagGroupIds =
  | 'Work-TagGroup-all'
  | 'Work-TagGroup-Methods'
  | 'Work-TagGroup-Systems'
  | 'Work-TagGroup-Mobility'
  | 'Work-TagGroup-Healthcare';

type TagGroup = {
  id: TagGroupIds;
  label: string;
  relatedTags: string[];
  icon: string;
  themeColor: string;
};

const allTagGroups: TagGroup[] = [
  {
    id: 'Work-TagGroup-all',
    label: 'All',
    relatedTags: [],
    icon: 'material-symbols:apps',
    themeColor: '#171717',
  },
  {
    id: 'Work-TagGroup-Methods',
    label: 'Methods',
    relatedTags: [],
    icon: 'material-symbols:science-outline',
    themeColor: '#1f2a44',
  },
  {
    id: 'Work-TagGroup-Systems',
    label: 'Systems',
    relatedTags: [],
    icon: 'material-symbols:account-tree-outline',
    themeColor: '#2b3a2e',
  },
  {
    id: 'Work-TagGroup-Mobility',
    label: 'Mobility',
    relatedTags: [],
    icon: 'material-symbols:directions-car',
    themeColor: '#3a2b2b',
  },
  {
    id: 'Work-TagGroup-Healthcare',
    label: 'Healthcare',
    relatedTags: [],
    icon: 'material-symbols:local-hospital-outline',
    themeColor: '#2b2e3a',
  },
];

export function getStaticPaths() {
  return Object.keys(languages).map((language) => ({
    params: { language },
  }));
}
---

<style is:inline>
  .active[data-group-id] {
    background-color: var(--themeColor);
    color: white;
    border-color: transparent;
  }

  [data-group-id]:hover {
    color: var(--themeColor);
  }
</style>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const groupFilterElement = document.querySelector('[data-group-filter]');
    const worksElement = document.querySelector('[data-works]');

    groupFilterElement?.addEventListener('click', (e) => {
      const button = e.target?.closest?.('button');
      if (!button) return;

      const groupId = button.dataset.groupId;

      groupFilterElement.querySelectorAll('button').forEach((btn) => {
        btn.classList.toggle('active', btn === button);
      });

      worksElement?.querySelectorAll('[data-group]').forEach((card) => {
        const group = card.getAttribute('data-group');
        const visible = groupId === 'Work-TagGroup-all' || group === groupId;
        card.classList.toggle('hidden', !visible);
      });
    });
  });
</script>

<Base title={t('Navbar-3')}>
  <main>
    <div class="mx-auto w-full max-w-screen-xl px-6">
      <!-- Header -->
      <section class="pt-[var(--navbar-height)]">
        <h1 class="text-3xl md:text-5xl font-medium">
          Selected Work
        </h1>
      </section>

      <!-- Filters -->
      <section class="mt-10">
        <ul class="flex flex-wrap gap-2" data-group-filter>
          {allTagGroups.map((group) => (
            <li>
              <button
                data-group-id={group.id}
                style={`--themeColor: ${group.themeColor};`}
                class="border-2 px-4 py-2 rounded-full inline-flex items-center gap-3 transition"
                type="button"
              >
                <Icon size={22} name={group.icon} />
                {group.label}
              </button>
            </li>
          ))}
        </ul>
      </section>

      <!-- Project list -->
      <section class="mt-16">
        <ul data-works class="flex flex-col gap-20">
          {sortedProjects.map((project) => {
            const id = String(project.id ?? '');
            const normalizedSlug = id.startsWith(`${currentLocale}/`)
              ? id.slice(currentLocale.length + 1)
              : id;

            return (
              <li
                data-group={project.data.type ? `Work-TagGroup-${project.data.type}` : 'Work-TagGroup-all'}
                class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start"
              >
                <!-- Image -->
                {project.data.thumbnail && (
                  <div class="w-full aspect-[4/3] rounded-2xl overflow-hidden bg-black/5">
                    <img
                      src={project.data.thumbnail}
                      alt={project.data.thumbnailAlt ?? project.data.title}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                )}

                <!-- Text -->
                <div class="flex flex-col gap-4 max-w-prose">
                  <h2 class="text-xl md:text-2xl font-medium">
                    {project.data.title}
                    <span class="opacity-60">
                      {' '}
                      — {project.data.publishDate.getFullYear()}
                    </span>
                  </h2>

                  {project.data.context && (
                    <p class="text-sm opacity-70">{project.data.context}</p>
                  )}

                  <p class="text-base">{project.data.description}</p>

                  {project.data.highlights?.length > 0 && (
                    <ul class="list-disc list-inside text-sm opacity-80">
                      {project.data.highlights.slice(0, 3).map((h) => (
                        <li>{typeof h === 'string' ? h : h.text}</li>
                      ))}
                    </ul>
                  )}

                  <div class="pt-4">
                    <a
                      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/${currentLocale}/work/${normalizedSlug}/`}
                      class="highlight text-lg"
                    >
                      View overview
                    </a>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </section>

      <div class="h-24"></div>
    </div>
  </main>
</Base>

---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { languages, type LanguageKey, useTranslations } from '@/i18n/i18n.ts';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const langs = Array.isArray(languages) ? languages : Object.keys(languages);
  const projects = await getCollection('project', (p) => !p.data.draft);

  return langs.flatMap((language) =>
    projects
      .filter((p) => p.id.startsWith(`${language}/`))
      .map((p) => {
        const slug = p.id.slice(language.length + 1);
        return { params: { language, slug } };
      }),
  );
}

const currentLocale = Astro.params.language as LanguageKey;
const t = useTranslations(currentLocale);

const slug = String(Astro.params.slug ?? '');

const projects = await getCollection(
  'project',
  (p) => !p.data.draft && p.id.startsWith(`${currentLocale}/`),
);

const project = projects.find((p) => p.id === `${currentLocale}/${slug}`);
if (!project) throw new Error(`Project not found: ${currentLocale}/${slug}`);

/* Data mapping */
const typeLabel = project.data.type ?? '';
const tags: string[] = Array.isArray(project.data.tags) ? project.data.tags : [];
const caseUrl: string = project.data.caseUrl ?? '';
const cover = project.data.thumbnail ?? null;
const coverAlt = project.data.thumbnailAlt ?? project.data.title;
const summary = project.data.description ?? project.data.context ?? '';

/** Highlights: accept string[] or {text:string}[] */
const highlightsRaw = Array.isArray(project.data.highlights) ? project.data.highlights : [];
const highlights = highlightsRaw
  .map((h: any) => (typeof h === 'string' ? h : h?.text ?? ''))
  .filter(Boolean);

const { Content } = await render(project);
---

<style is:inline>
  /* --- Tag: Twitter-like hashtag (pure text, one per line) --- */
  .tag-hash {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0;
    border: 0;
    background: transparent;
    line-height: 1.35;
  }
  .tag-hash .hash {
    opacity: 0.55;
  }

  /* --- CTA pill button (desktop hover; mobile default "hovered") --- */
  .btn-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    padding: 1rem 1.5rem; /* height close to your previous Read full case */
    gap: 0.5rem;
    width: 100%;
    border: 1px solid rgba(0, 0, 0, 0.18);
    background: transparent;
    color: inherit;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .btn-pill:hover {
    background: rgba(0, 0, 0, 0.9);
    color: white;
    border-color: rgba(0, 0, 0, 0.9);
  }

  /* Mobile has no hover: show the "hovered" dark style by default */
  @media (max-width: 767px) {
    .btn-pill {
      background: rgba(0, 0, 0, 0.9);
      color: white;
      border-color: rgba(0, 0, 0, 0.9);
    }
  }

  /* Details summary aesthetics */
  .details-summary {
    list-style: none;
  }
  .details-summary::-webkit-details-marker {
    display: none;
  }

  /* Make ALL images/figures in MDX match cover style */
  :global(.case-prose figure),
  :global(.case-prose img),
  :global(.case-prose video),
  :global(.case-prose iframe) {
    border-radius: 1.5rem; /* ≈ rounded-3xl */
  }

  :global(.case-prose figure),
  :global(.case-prose img) {
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: rgba(0, 0, 0, 0.02);
  }

  :global(.dark .case-prose figure),
  :global(.dark .case-prose img) {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.03);
  }

  :global(.case-prose img) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>

<Base title={project.data.title}>
  <main>
    <div class="mx-auto w-full max-w-[56rem] px-6">
      <!-- ================= Hero ================= -->
      <section class="pt-[var(--navbar-height)]">
        {typeLabel ? (
          <div class="mb-6">
            <span class="inline-flex items-center gap-2 text-sm font-normal text-primary-900">
              <Icon name="material-symbols:science-outline" size={18} />
              {typeLabel}
            </span>
          </div>
        ) : null}

        <h1 class="text-4xl md:text-6xl font-semibold leading-[1.05] tracking-tight">
          {project.data.title}
        </h1>

        <!-- Cover image: responsive aspect ratios -->
        <div
          class="
            mt-8 w-full overflow-hidden rounded-3xl border border-black/10 bg-black/5
            aspect-[4/3]
            sm:aspect-[16/10]
            md:aspect-[16/9]
            lg:aspect-[21/9]
          "
        >
          {cover ? (
            typeof cover === 'string' ? (
              <img src={cover} alt={coverAlt} class="h-full w-full object-cover" loading="lazy" />
            ) : (
              <Image src={cover} alt={coverAlt} class="h-full w-full object-cover" loading="lazy" />
            )
          ) : null}
        </div>
      </section>

      <!-- ================= Overview (two-column) ================= -->
      <section class="mt-12">
        <div class="grid gap-10 md:grid-cols-[1fr_240px] md:gap-14 items-start">
          <!-- Left: description + highlight -->
          <div class="min-w-0">
            {summary ? <p class="text-lg leading-relaxed opacity-90">{summary}</p> : null}

            {highlights.length > 0 ? (
              <div class="mt-10">
                <div class="text-base font-semibold">Highlight</div>
                <ul class="mt-4 space-y-2 text-sm opacity-90">
                  {highlights.map((h) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-black/40"></span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null}
          </div>

          <!-- Right: tags + CTA (desktop only) -->
          <aside class="space-y-6">
            {tags.length > 0 ? (
              <div class="hidden md:block">
                <div class="mb-3 text-sm font-semibold opacity-70">Tag</div>
                <ul class="flex flex-col gap-2 text-base">
                  {tags.map((tag) => (
                    <li class="tag-hash">
                      <span class="hash text-primary-600">#</span>
                      <span class="label text-primary-900">{tag}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null}

            {/* Desktop CTA stays here */}
            {caseUrl ? (
              <div class="hidden md:block">
                <a
                  href={caseUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-pill"
                >
                  Read full case
                  <span aria-hidden="true" class="inline-flex">
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M14 5H19V10"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M10 14L19 5"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M19 14V19H5V5H10"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </a>
              </div>
            ) : null}
          </aside>
        </div>
      </section>

      <!-- ================= Body ================= -->
      <section class="mt-12">
        <div class="case-prose prose prose-zinc max-w-none dark:prose-invert">
          <Content />
        </div>

        <!-- Mobile: Tags at the end (collapsed) + Mobile CTA AFTER tags -->
        {tags.length > 0 ? (
          <div class="mt-12 md:hidden">
            <details class="rounded-2xl border border-black/10 bg-black/5 p-4">
              <summary class="details-summary flex cursor-pointer items-center justify-between">
                <span class="text-sm font-semibold opacity-80">Tags</span>
                <span class="opacity-60" aria-hidden="true">+</span>
              </summary>

              {/* IMPORTANT: hashtag list, not pills */}
              <ul class="mt-4 flex flex-col gap-2 text-base">
                {tags.map((tag) => (
                  <li class="tag-hash">
                    <span class="hash text-primary-600">#</span>
                    <span class="label text-primary-900">{tag}</span>
                  </li>
                ))}
              </ul>
            </details>
          </div>
        ) : null}

        {/* Mobile CTA goes here (end of page content) */}
        {caseUrl ? (
          <div class="mt-8 md:hidden">
            <a
              href={caseUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-pill"
            >
              Read full case
              <span aria-hidden="true" class="inline-flex">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M14 5H19V10"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M10 14L19 5"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M19 14V19H5V5H10"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          </div>
        ) : null}
      </section>

      <div class="h-24"></div>
    </div>
  </main>
</Base>

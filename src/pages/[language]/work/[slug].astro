---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('project', (p) => !p.data.draft);
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<Base title={project.data.title}>
  <main class="container mx-auto p-4 md:p-8 max-w-3xl">
    <a class="underline opacity-70" href="/work/">← Back to Work</a>

    <header class="mt-6">
      <h1 class="text-3xl md:text-5xl font-semibold">{project.data.title}</h1>
      <p class="mt-4 text-lg opacity-80">{project.data.description}</p>

      <div class="mt-4 flex flex-wrap gap-2">
        {project.data.tech.map((t) => (
          <span class="border-2 px-3 py-1 rounded-full text-sm">{t}</span>
        ))}
      </div>

      {project.data.externalUrl && (
        <div class="mt-6">
          <a class="underline" href={project.data.externalUrl} target="_blank" rel="noopener">
            View external link
          </a>
        </div>
      )}
    </header>

    <article class="prose prose-neutral max-w-none mt-10">
      <Content />
    </article>
  </main>
</Base>

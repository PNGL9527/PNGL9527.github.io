---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { languages, type LanguageKey, useTranslations } from '@/i18n/i18n.ts';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const langs = Array.isArray(languages) ? languages : Object.keys(languages);
  const projects = await getCollection('project', (p) => !p.data.draft);

  return langs.flatMap((language) =>
    projects
      .filter((p) => p.id.startsWith(`${language}/`))
      .map((p) => {
        const slug = p.id.slice(language.length + 1);
        return { params: { language, slug } };
      }),
  );
}

const currentLocale = Astro.params.language as LanguageKey;
const t = useTranslations(currentLocale);

const slug = String(Astro.params.slug ?? '');

const projects = await getCollection(
  'project',
  (p) => !p.data.draft && p.id.startsWith(`${currentLocale}/`),
);

const project = projects.find((p) => p.id === `${currentLocale}/${slug}`);
if (!project) throw new Error(`Project not found: ${currentLocale}/${slug}`);

/* Data mapping */
const typeLabel = project.data.type ?? '';
const tags: string[] = Array.isArray(project.data.tags) ? project.data.tags : [];
const caseUrl: string = project.data.caseUrl ?? '';
const cover = project.data.thumbnail ?? null;
const coverAlt = project.data.thumbnailAlt ?? project.data.title;
const summary = project.data.description ?? project.data.context ?? '';

/** Highlights: accept string[] or {text:string}[] */
const highlightsRaw = Array.isArray(project.data.highlights) ? project.data.highlights : [];
const highlights = highlightsRaw
  .map((h: any) => (typeof h === 'string' ? h : h?.text ?? ''))
  .filter(Boolean);

const { Content } = await render(project);
---

<style is:inline>
  .tag-pill {
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: rgba(0, 0, 0, 0.02);
  }
  :global(.dark) .tag-pill {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Touch-friendly CTA button (pill) */
  .case-btn {
    border: 1px solid rgba(0, 0, 0, 0.18);
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(6px);
  }
  :global(.dark) .case-btn {
    border-color: rgba(255, 255, 255, 0.22);
    background: rgba(0, 0, 0, 0.18);
  }

  /* Details summary aesthetics */
  .details-summary {
    list-style: none;
  }
  .details-summary::-webkit-details-marker {
    display: none;
  }

  /* Make ALL images/figures in MDX match cover style */
  :global(.case-prose figure),
  :global(.case-prose img),
  :global(.case-prose video),
  :global(.case-prose iframe) {
    border-radius: 1.5rem; /* ≈ rounded-3xl */
  }

  :global(.case-prose figure),
  :global(.case-prose img) {
    border: 1px solid rgba(0, 0, 0, 0.10);
    background: rgba(0, 0, 0, 0.02);
  }

  :global(.dark .case-prose figure),
  :global(.dark .case-prose img) {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.03);
  }

  :global(.case-prose img) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>

<Base title={project.data.title}>
  <main>
    <!-- Content rail -->
    <div class="mx-auto w-full max-w-[56rem] px-6">
      <!-- ================= Hero ================= -->
      <section class="pt-[var(--navbar-height)]">
        {typeLabel ? (

<div class="mb-6">
  <span class="inline-flex items-center gap-2 text-sm font-normal text-black">
    <Icon name="material-symbols:science-outline" size={18} />
    {typeLabel}
  </span>
</div>


        ) : null}

        <h1 class="text-4xl md:text-6xl font-semibold leading-[1.05] tracking-tight">
          {project.data.title}
        </h1>

        <!-- Cover image: responsive aspect ratios -->
        <div
          class="
            mt-8 w-full overflow-hidden rounded-3xl border border-black/10 bg-black/5
            aspect-[4/3]
            sm:aspect-[16/10]
            md:aspect-[16/9]
            lg:aspect-[21/9]
          "
        >
          {cover ? (
            typeof cover === 'string' ? (
              <img
                src={cover}
                alt={coverAlt}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            ) : (
              <Image
                src={cover}
                alt={coverAlt}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            )
          ) : null}
        </div>
      </section>

      <!-- ================= Overview (two-column) ================= -->
      <section class="mt-12">
        <div class="grid gap-10 md:grid-cols-[1fr_240px] md:gap-14 items-start">
          <!-- Left: description + highlight (same width) -->
          <div class="min-w-0">
            {summary ? (
              <p class="text-lg leading-relaxed opacity-90">
                {summary}
              </p>
            ) : null}

            {/* ✅ Highlight right after description */}
            {highlights.length > 0 ? (
              <div class="mt-10">
                <div class="text-base font-semibold">Highlight</div>
                <ul class="mt-4 space-y-2 text-sm opacity-90">
                  {highlights.map((h) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-black/40"></span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null}
          </div>

          <!-- Right: tags + CTA -->
          <aside class="space-y-6">
            {/* Desktop: tags in sidebar */}
            {tags.length > 0 ? (
              <div class="hidden md:block">
                <div class="mb-3 text-sm font-semibold opacity-70">Tag</div>
                <div class="flex flex-col gap-2">
                  {tags.map((tag) => (
                    <span class="tag-pill inline-flex w-fit rounded-lg px-3 py-2 text-sm">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            ) : null}

            {/* CTA button */}
            {caseUrl ? (
              <div>
                <a
                  href={caseUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="
                    case-btn
                    inline-flex items-center justify-center gap-2
                    rounded-full
                    px-6 py-4
                    font-semibold
                    w-full
                  "
                >
                  Read full case <span aria-hidden="true">↗</span>
                </a>
              </div>
            ) : null}
          </aside>
        </div>
      </section>

      <!-- ================= Body (cover-aligned full rail) ================= -->
      <section class="mt-12">
        <div class="case-prose prose prose-zinc max-w-none dark:prose-invert">
          <Content />
        </div>

        {/* Mobile: move tags to the end, collapsed */}
        {tags.length > 0 ? (
          <div class="mt-12 md:hidden">
            <details class="rounded-2xl border border-black/10 bg-black/5 p-4">
              <summary class="details-summary flex cursor-pointer items-center justify-between">
                <span class="text-sm font-semibold opacity-80">Tags</span>
                <span class="opacity-60" aria-hidden="true">+</span>
              </summary>

              <div class="mt-4 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <span class="tag-pill inline-flex rounded-lg px-3 py-2 text-sm">
                    {tag}
                  </span>
                ))}
              </div>
            </details>
          </div>
        ) : null}
      </section>

      <div class="h-24"></div>
    </div>
  </main>
</Base>

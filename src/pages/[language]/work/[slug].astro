---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { languages, type LanguageKey, useTranslations } from '@/i18n/i18n.ts';
import { Image } from 'astro:assets';
import ProjectCard from '../../../components/ProjectCard.astro';


/* ---------------- getStaticPaths ---------------- */
export async function getStaticPaths() {
  const langs = Array.isArray(languages) ? languages : Object.keys(languages);
  const projects = await getCollection('project', (p) => !p.data.draft);

  return langs.flatMap((language) =>
    projects
      .filter((p) => p.id.startsWith(`${language}/`))
      .map((p) => ({
        params: {
          language,
          slug: p.id.slice(language.length + 1),
        },
      })),
  );
}

/* ---------------- Page data ---------------- */
const currentLocale = Astro.params.language as LanguageKey;
const t = useTranslations(currentLocale);

const slug = String(Astro.params.slug ?? '');

const projects = await getCollection(
  'project',
  (p) => !p.data.draft && p.id.startsWith(`${currentLocale}/`),
);

const project = projects.find((p) => p.id === `${currentLocale}/${slug}`);
if (!project) throw new Error(`Project not found: ${currentLocale}/${slug}`);

/* ---------------- Mapping ---------------- */
const typeLabel = project.data.type ?? '';

const typeToIcon: Record<string, string> = {
  Research: 'material-symbols:science-outline',
  Product: 'material-symbols:widgets-outline',
  Service: 'material-symbols:handshake-outline',
  Strategy: 'material-symbols:strategy',
  Prototype: 'material-symbols:biotech-outline',
};

const typeIcon = typeToIcon[typeLabel] ?? 'material-symbols:apps';

/* ---------------- Content ---------------- */
const tags: string[] = Array.isArray(project.data.tags) ? project.data.tags : [];
const caseUrl: string = project.data.caseUrl ?? '';
const cover = project.data.thumbnail ?? null;
const coverAlt = project.data.thumbnailAlt ?? project.data.title;
const summary = project.data.description ?? project.data.context ?? '';

const highlightsRaw = Array.isArray(project.data.highlights)
  ? project.data.highlights
  : [];
const highlights = highlightsRaw
  .map((h: any) => (typeof h === 'string' ? h : h?.text ?? ''))
  .filter(Boolean);

const { Content } = await render(project);

/* ---------------- More selected work (logic) ---------------- */
const currentType = typeLabel || null;
const currentId = project.id;

const pool = projects.filter((p) => p.id !== currentId);

const getType = (p: any) => (p?.data?.type ?? null);

const sameType = currentType ? pool.filter((p) => getType(p) === currentType) : [];
const otherType = currentType ? pool.filter((p) => getType(p) !== currentType) : pool;

const byDateDesc = (a: any, b: any) => {
  const ad = a.data?.publishDate ? new Date(a.data.publishDate).getTime() : 0;
  const bd = b.data?.publishDate ? new Date(b.data.publishDate).getTime() : 0;
  return bd - ad;
};

sameType.sort(byDateDesc);
otherType.sort(byDateDesc);

const relatedProjects = [...sameType, ...otherType].slice(0, 2);

// 返回到 Selected work 列表页
const backToWorkHref = `/${currentLocale}/work`;
---

<style is:inline>
  /* ---------- Tag (Twitter-like text) ---------- */
  .tag-text {
    color: rgba(0, 0, 0, 0.6);
    font-size: 0.875rem;
  }

  /* ---------- CTA buttons ---------- */
  .case-btn {
    border: 1px solid rgba(0, 0, 0, 0.25);
    background: transparent;
    transition: background 0.15s ease, color 0.15s ease;
  }

  @media (hover: hover) {
    .case-btn:hover {
      background: #111;
      color: white;
    }
  }

  @media (hover: none) {
    .case-btn {
      background: #111;
      color: white;
    }
  }

  /* ---------- MDX media ---------- */
  :global(.case-prose img),
  :global(.case-prose figure),
  :global(.case-prose video),
  :global(.case-prose iframe) {
    border-radius: 1.5rem;
    width: 100%;
    display: block;
  }
</style>

<Base title={project.data.title}>
  <main>
    <div class="mx-auto w-full max-w-[56rem] px-6">
      <!-- ================= Hero ================= -->
      <section class="pt-[var(--navbar-height)]">
        {typeLabel && (
          <div class="mb-6">
            <span class="inline-flex items-center gap-2 text-sm font-normal text-primary-900">
              <Icon name={typeIcon} size={18} />
              {typeLabel}
            </span>
          </div>
        )}

        <h1
          class="
            text-3xl
            sm:text-4xl
            md:text-5xl
            lg:text-6xl
            font-semibold
            leading-[1.25]
            sm:leading-[1.2]
            md:leading-[1.15]
            lg:leading-[1.1]
            tracking-tight
          "
        >
          {project.data.title}
        </h1>

        <!-- Cover -->
        <div
          class="
            mt-8 w-full overflow-hidden rounded-3xl border border-black/10 bg-black/5
            aspect-[4/3]
            sm:aspect-[16/10]
            md:aspect-[16/9]
            lg:aspect-[21/9]
          "
        >
          {cover &&
            (typeof cover === 'string' ? (
              <img src={cover} alt={coverAlt} class="h-full w-full object-cover" />
            ) : (
              <Image src={cover} alt={coverAlt} class="h-full w-full object-cover" />
            ))}
        </div>
      </section>

      <!-- ================= Overview ================= -->
      <section class="mt-12">
        <div class="grid gap-10 md:grid-cols-[1fr_240px] md:gap-14">
          <!-- Left -->
          <div>
            {summary && <p class="text-lg leading-relaxed text-primary-700">{summary}</p>}

            {highlights.length > 0 && (
              <div class="mt-10">
                <div class="text-base font-semibold">Highlight</div>
                <ul class="mt-4 space-y-2 text-sm text-primary-700">
                  {highlights.map((h) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-1.5 w-1.5 rounded-full bg-black/40"></span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <!-- Right (desktop) -->
          <aside class="space-y-6 hidden md:block">
            {tags.length > 0 && (
              <div>
                <div class="mb-3 text-sm font-semibold opacity-70">Tags</div>
                <div class="flex flex-col gap-1">
                  {tags.map((tag) => (
                    <span class="tag-text">#{tag}</span>
                  ))}
                </div>
              </div>
            )}

            {caseUrl && (
              <a
                href={caseUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="case-btn inline-flex w-full items-center justify-center gap-2 rounded-full px-6 py-4 font-semibold"
              >
                Read full case
                <Icon name="material-symbols:open-in-new-rounded" size={18} />
              </a>
            )}
          </aside>
        </div>
      </section>

      <!-- ================= Body ================= -->
      <section class="mt-12">
        <div class="case-prose prose prose-zinc max-w-none">
          <Content />
        </div>

        <!-- Mobile: tags + CTA at bottom -->
        {(tags.length > 0 || caseUrl) && (
          <div class="mt-12 md:hidden space-y-8">
            {tags.length > 0 && (
              <details class="rounded-2xl border border-black/10 bg-black/5 p-4">
                <summary class="flex cursor-pointer justify-between text-sm font-semibold">
                  Tags <span>+</span>
                </summary>
                <div class="mt-4 flex flex-col gap-1">
                  {tags.map((tag) => (
                    <span class="tag-text">#{tag}</span>
                  ))}
                </div>
              </details>
            )}

            {caseUrl && (
              <a
                href={caseUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="case-btn inline-flex w-full items-center justify-center gap-2 rounded-full px-6 py-5 font-semibold"
              >
                Read full case
                <Icon name="material-symbols:open-in-new-rounded" size={18} />
              </a>
            )}
          </div>
        )}
      </section>

      <!-- ================= More selected work ================= -->
      {relatedProjects.length > 0 && (
        <section class="mt-16 md:mt-20">
          <div class="flex items-start justify-between gap-6">
            <h2 class="text-xl sm:text-2xl font-semibold tracking-tight">
  Continue exploring
</h2>


            <!-- Desktop button: on the right, “Read full case” style logic -->
            <a
              href={backToWorkHref}
              class="case-btn hidden md:inline-flex items-center justify-center rounded-full px-5 py-3 font-semibold"
            >
              View all projects
            </a>
          </div>

          <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
            {relatedProjects.map((p) => (
              <ProjectCard project={p} currentLocale={currentLocale} />
            ))}
          </div>

          <!-- Mobile button: text-width button placed AFTER the two cards -->
<div class="mt-6 md:hidden">
  <a
    href={backToWorkHref}
    class="case-btn inline-flex w-full items-center justify-center rounded-full px-6 py-5 font-semibold"
  >
    View all projects
  </a>
</div>

        </section>
      )}

      <div class="h-24"></div>
    </div>
  </main>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { languages, type LanguageKey, useTranslations } from '@/i18n/i18n.ts';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const langs = Array.isArray(languages) ? languages : Object.keys(languages);
  const projects = await getCollection('project', (p) => !p.data.draft);

  return langs.flatMap((language) =>
    projects
      .filter((p) => p.id.startsWith(`${language}/`))
      .map((p) => {
        const slug = p.id.slice(language.length + 1);
        return { params: { language, slug } };
      }),
  );
}

const currentLocale = Astro.params.language as LanguageKey;
const t = useTranslations(currentLocale);

const slug = String(Astro.params.slug ?? '');

const projects = await getCollection(
  'project',
  (p) => !p.data.draft && p.id.startsWith(`${currentLocale}/`),
);

const project = projects.find((p) => p.id === `${currentLocale}/${slug}`);
if (!project) throw new Error(`Project not found: ${currentLocale}/${slug}`);

/* Data mapping */
const typeLabel = project.data.type ?? '';
const tags: string[] = Array.isArray(project.data.tags) ? project.data.tags : [];
const caseUrl: string = project.data.caseUrl ?? '';
const cover = project.data.thumbnail ?? null;
const coverAlt = project.data.thumbnailAlt ?? project.data.title;
const summary = project.data.description ?? project.data.context ?? '';
---

<style is:inline>
  .tag-pill {
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: rgba(0, 0, 0, 0.02);
  }
  :global(.dark) .tag-pill {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
  }

  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>

<Base title={project.data.title}>
  <main>
    <!-- ✅ Content rail: STATIC class so Tailwind definitely generates it -->
    <!-- You can adjust ONE number: max-w-[56rem] -->
    <div class="mx-auto w-full max-w-[56rem] px-6">
      <!-- =============== Hero =============== -->
      <section class="pt-[var(--navbar-height)]">
        {typeLabel ? (
          <div class="mb-6">
            <span class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-black/5 px-4 py-2 text-sm font-medium">
              <Icon name="material-symbols:science-outline" size={18} />
              {typeLabel}
            </span>
          </div>
        ) : null}

        <h1 class="text-4xl md:text-6xl font-semibold leading-[1.05] tracking-tight">
          {project.data.title}
        </h1>

        <div
  class="
    mt-8
    w-full
    overflow-hidden
    rounded-3xl
    border border-black/10
    bg-black/5

    aspect-[4/3]
    sm:aspect-[16/10]
    md:aspect-[16/9]
    lg:aspect-[21/9]
  "
>

          {cover ? (
            typeof cover === 'string' ? (
              <img
                src={cover}
                alt={coverAlt}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            ) : (
              <Image
                src={cover}
                alt={coverAlt}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            )
          ) : null}
        </div>
      </section>

      <!-- =============== Overview =============== -->
      <section class="mt-12">
        <div class="grid gap-10 md:grid-cols-[240px_1fr] md:gap-14">
          <aside class="space-y-8">
            {tags.length > 0 ? (
              <div>
                <div class="mb-3 text-sm font-semibold opacity-70">Tag</div>
                <div class="flex flex-col gap-2">
                  {tags.map((tag) => (
                    <span class="tag-pill inline-flex w-fit rounded-lg px-3 py-2 text-sm">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            ) : null}

            {caseUrl ? (
              <div>
                <a
                  href={caseUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="case-link highlight text-base font-medium"
                >
                  Read full case <span aria-hidden="true">↗</span>
                </a>
              </div>
            ) : null}
          </aside>

          <div class="min-w-0">
            {summary ? (
              <p class="text-lg leading-relaxed opacity-90">
                {summary}
              </p>
            ) : null}
          </div>
        </div>
      </section>

      <div class="h-24"></div>
    </div>
  </main>
</Base>

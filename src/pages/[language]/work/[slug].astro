---
import Base from '@/layouts/Base.astro';
import Banner from '@/components/Banner.astro';
import { getCollection, render } from 'astro:content';
import { languages, type LanguageKey } from '@/i18n/i18n.ts';

type Params = { language: LanguageKey; slug: string };

export async function getStaticPaths() {
  const entries = await getCollection('project', (e) => !e.data.draft);

  return entries
    .map((e) => {
      const id = String(e.id ?? '');
      const inferredLang = id.split('/')[0] as LanguageKey;

      if (!languages[inferredLang]) return null;

      const normalizedSlug = id.startsWith(`${inferredLang}/`)
        ? id.slice(inferredLang.length + 1)
        : id;

      if (!normalizedSlug) return null;

      return {
        params: {
          language: inferredLang,
          slug: normalizedSlug,
        },
      };
    })
    .filter(Boolean);
}

const { language, slug } = Astro.params as Params;

const entries = await getCollection('project', (e) => !e.data.draft);

const project = entries.find((e) => {
  const id = String(e.id ?? '');
  const normalized = id.startsWith(`${language}/`)
    ? id.slice(language.length + 1)
    : id;
  return normalized === slug;
});

if (!project) {
  throw new Error(`Project not found: ${language}/${slug}`);
}

const { Content } = await render(project);

const tags = project.data.tags ?? [];
---

<Base title={project.data.title}>
  <main>
    {/* Header: aligned + same width system as body */}
    <Banner>
      <div class="container mx-auto px-4 max-w-6xl">
        <h1 class="font-semibold">
          <span class="block text-3xl md:text-6xl leading-tight">
            {project.data.title}
          </span>
        </h1>

        {/* Description under title (controlled width) */}
        <p class="mt-6 text-lg opacity-90 max-w-3xl">
          {project.data.description}
        </p>

        {/* Meta blocks */}
        <div class="mt-6 space-y-6">
          {/* Highlights with label + robust rendering */}
          {project.data.highlights?.length > 0 && (
            <div class="space-y-2">
              <p class="text-sm font-medium uppercase tracking-wider opacity-60">
                Highlights
              </p>

              <ul class="list-disc list-inside">
                {project.data.highlights.map((h) => {
                  // Case 1: normal string
                  if (typeof h === 'string') return <li>{h}</li>;

                  // Case 2: schema-defined object { title?, text?, items? }
                  if (h && typeof h === 'object') {
                    const title = 'title' in h ? h.title : undefined;
                    const text = 'text' in h ? h.text : undefined;
                    const items = 'items' in h ? h.items : undefined;

                    // Case 3: YAML "Key: Value" mapping becomes { "Key": "Value" }
                    // Render it as "Key: Value"
                    if (!title && !text && !items) {
                      const entries = Object.entries(h);
                      if (entries.length === 1) {
                        const [k, v] = entries[0];
                        return <li>{`${k}: ${String(v)}`}</li>;
                      }
                      return <li>{JSON.stringify(h)}</li>;
                    }

                    // Render structured form if you use it later
                    return (
                      <li>
                        {title ? <strong>{title}</strong> : null}
                        {title && text ? ': ' : null}
                        {text ? <span>{text}</span> : null}
                        {items?.length ? (
                          <ul class="list-disc list-inside mt-2 opacity-90">
                            {items.map((it) => <li>{it}</li>)}
                          </ul>
                        ) : null}
                      </li>
                    );
                  }

                  return <li>{String(h)}</li>;
                })}
              </ul>
            </div>
          )}

          {/* Tags */}
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="border border-primary-100 px-3 py-1 rounded-full text-xs">
                  {tag}
                </span>
              ))}
            </div>
          )}

          {/* Links */}
          <div class="flex flex-wrap gap-4 pt-2">
            <a
              href="../"
              class="highlight text-base md:text-lg font-medium inline-block opacity-80"
            >
              ← Back to selected work
            </a>

            {project.data.caseUrl && (
              <a
                href={project.data.caseUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="highlight text-base md:text-lg font-medium inline-block"
              >
                Read full case ↗
              </a>
            )}
          </div>
        </div>
      </div>
    </Banner>

    {/* Body: same width as header container */}
    <article class="container mx-auto px-4 max-w-6xl">
      <hr class="my-10 opacity-20" />

      {/* Content only (avoid duplicating title/description in body) */}
      <section class="prose prose-lg max-w-none">
        <Content />
      </section>
    </article>

    <div class="h-20"></div>
  </main>
</Base>

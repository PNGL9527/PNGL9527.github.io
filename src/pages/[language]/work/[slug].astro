---
import Base from '@/layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { languages, type LanguageKey } from '@/i18n/i18n.ts';

type Params = { language: LanguageKey; slug: string };

export async function getStaticPaths() {
  const entries = await getCollection('project', (e) => !e.data.draft);

  return entries
    .map((e) => {
      const id = String(e.id ?? ''); // e.g. "en/co-driving-pleasure"
      const inferredLang = id.split('/')[0] as LanguageKey;

      if (!languages[inferredLang]) return null;

      const normalizedSlug = id.startsWith(`${inferredLang}/`)
        ? id.slice(inferredLang.length + 1)
        : id;

      if (!normalizedSlug) return null;

      return {
        params: {
          language: inferredLang,
          slug: normalizedSlug,
        } satisfies Params,
      };
    })
    .filter(Boolean) as Array<{ params: Params }>;
}

const { language, slug } = Astro.params as Params;

// 先用 getCollection 找到目标条目的 id
const entries = await getCollection('project', (e) => !e.data.draft);

const hit = entries.find((e) => {
  const id = String(e.id ?? '');
  const normalized = id.startsWith(`${language}/`)
    ? id.slice(language.length + 1)
    : id;
  return normalized === slug;
});

if (!hit) {
  throw new Error(`Project not found: ${language}/${slug}`);
}

// 再用 getEntry 拿到真正的 entry
const project = await getEntry('project', hit.id);

if (!project) {
  throw new Error(`Project entry not found by id: ${String(hit.id)}`);
}

const tags = project.data.tags ?? [];

// ✅ Astro 5.8 content layer：用 render(entry) 获取жаў Content 组件
const { Content } = await render(project);
---

<Base title={project.data.title}>
  <main class="container mx-auto px-4 md:px-8 py-12">

    <article class="max-w-6xl space-y-6">
      <header class="space-y-3">
        <h1 class="text-3xl md:text-5xl font-semibold">
          {project.data.title}
        </h1>

        <p class="text-lg opacity-90">
          {project.data.description}
        </p>

        {project.data.highlights?.length > 0 && (
          <ul class="list-disc list-inside">
            {project.data.highlights.map((h) => <li>{h}</li>)}
          </ul>
        )}

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-2">
            {tags.map((tag) => (
              <span class="border border-primary-100 px-3 py-1 rounded-full text-xs">
                {tag}
              </span>
            ))}
          </div>
        )}

        <div class="flex gap-4 pt-4">
          {project.data.caseUrl && (
            <a href={project.data.caseUrl} class="underline underline-offset-4">
              Read full case
            </a>
          )}
          <a href="../" class="underline underline-offset-4 opacity-70">
            Back to selected work
          </a>
        </div>
      </header>

      <hr class="my-8" />

      <section class="prose max-w-none">
        <Content />
      </section>
    </article>
  </main>
</Base>

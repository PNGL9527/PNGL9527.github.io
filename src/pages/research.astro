---
import Base from '@/layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { publications, researchProfiles } from '@/data/publications';

const interests = [
  {
    number: '01',
    title: 'Human–technology relations',
    description:
      'How increasingly agentic technologies reshape human experience, agency, trust, and emotional relationships.',
  },
  {
    number: '02',
    title: 'Research through tools',
    description:
      'How conceptual models and participatory tools can translate qualitative insight into practical design action.',
  },
  {
    number: '03',
    title: 'Socio-technical systems',
    description:
      'How services, technologies, organizations, and everyday practices interact across complex systems.',
  },
];
---

<Base
  title="Research & Publications"
  description="Peng Lu’s research interests, doctoral work, and selected publications."
>
  <main>
    <div class="mx-auto w-full max-w-screen-xl px-6">
      <section class="pt-[var(--navbar-height)] max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-500">
          Research & Publications
        </p>
        <h1 class="mt-5 text-4xl font-semibold leading-tight tracking-tight md:text-6xl">
          Understanding relations between people, technologies, and systems.
        </h1>
        <p class="mt-8 max-w-3xl text-xl leading-relaxed text-primary-700 md:text-2xl">
          My research combines qualitative and quantitative inquiry, conceptual framework development,
          design experimentation, and studio teaching. I translate lived experience into methods and tools
          that can inform emerging technologies, complex services, and project-based design education.
        </p>
      </section>

      <section class="mt-20 border-t border-black/10 pt-10 md:mt-28">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-500">Current research</p>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <article class="rounded-3xl bg-black/5 p-7 md:p-9">
            <p class="text-sm text-primary-500">Doctoral research · 2021–2025</p>
            <h2 class="mt-4 text-2xl font-semibold">Co-Driving Pleasure and Human-Vehicle Relations</h2>
            <p class="mt-4 leading-relaxed text-primary-700">
              A multi-method HCI and design study of how automated mobility mediates experience, agency,
              trust, and human–vehicle relations. The work involved 25 participant drivers, more than 110
              trip-experience reports, and interviews with nine automotive practitioners.
            </p>
          </article>
          <article class="rounded-3xl bg-black/5 p-7 md:p-9">
            <p class="text-sm text-primary-500">Independent research · 2025–present</p>
            <h2 class="mt-4 text-2xl font-semibold">Mediation Composition Diagram</h2>
            <p class="mt-4 leading-relaxed text-primary-700">
              A diagrammatic approach for examining how multiple technologies organize situated
              human–technology relations, salience, and agency. The method introduces mediation granularity
              as an analytical concept and informs forthcoming NordiCHI 2026 work.
            </p>
          </article>
        </div>
      </section>

      <section class="mt-20 border-t border-black/10 pt-10 md:mt-28">
        <h2 class="text-2xl font-semibold md:text-3xl">Research interests</h2>
        <div class="mt-8 grid gap-px overflow-hidden rounded-3xl border border-black/10 bg-black/10 md:grid-cols-3">
          {interests.map((interest) => (
            <article class="bg-white p-7 md:p-8">
              <span class="text-sm text-primary-500">{interest.number}</span>
              <h3 class="mt-8 text-xl font-semibold">{interest.title}</h3>
              <p class="mt-3 leading-relaxed text-primary-700">{interest.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="publications" class="mt-20 scroll-mt-28 border-t border-black/10 pt-10 md:mt-28">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-500">Selected output</p>
            <h2 class="mt-3 text-2xl font-semibold md:text-3xl">Publications</h2>
          </div>
          <div class="flex flex-wrap gap-4">
            {researchProfiles.map((profile) => (
              <a
                href={profile.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-semibold underline decoration-black/25 underline-offset-4 hover:decoration-black"
              >
                {profile.label}
                <Icon name="material-symbols:open-in-new-rounded" size={16} />
              </a>
            ))}
          </div>
        </div>

        <ol class="mt-8 divide-y divide-black/10 border-y border-black/10">
          {publications.map((publication) => (
            <li>
              <div class="group grid gap-4 py-7 md:grid-cols-[6rem_1fr_auto] md:items-start md:gap-8">
                <div class="text-sm text-primary-500">{publication.year}</div>
                <div>
                  {publication.url ? (
                    <h3 class="text-lg font-semibold leading-snug">
                      <a
                        href={publication.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:underline hover:underline-offset-4"
                      >
                        {publication.title}
                      </a>
                    </h3>
                  ) : (
                    <h3 class="text-lg font-semibold leading-snug">{publication.title}</h3>
                  )}
                  <p class="mt-2 text-sm leading-relaxed text-primary-700">{publication.authors}</p>
                  <p class="mt-1 text-sm italic text-primary-500">{publication.venue}</p>
                </div>
                <span class="w-fit rounded-full border border-black/15 px-3 py-1 text-xs text-primary-700">
                  {publication.type}
                </span>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="my-20 rounded-3xl bg-primary-900 p-8 text-primary-50 md:my-28 md:p-12">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-300">Current direction</p>
        <h2 class="mt-4 max-w-3xl text-2xl font-semibold leading-snug md:text-4xl">
          Developing research-informed tools for human–AI interaction and more relational design practices.
        </h2>
      </section>
    </div>
  </main>
</Base>

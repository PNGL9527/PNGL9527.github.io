---
import Base from '@/layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { publications, researchProfiles } from '@/data/publications';

const interests = [
  {
    number: '01',
    title: 'How do mediated experiences and practices emerge and change in context?',
    description:
      'I examine how material, social, cultural, and institutional circumstances shape human–technology relations, including how people come to value particular relational qualities over time.',
  },
  {
    number: '02',
    title: 'How can articulating relations generate knowledge for design?',
    description:
      'Diagrams, cards, and other research resources make analytical choices and differing interpretations discussable. Their use and revision can develop experiential insights, concepts, and methods.',
  },
  {
    number: '03',
    title: 'How can design inquiry explore new relational possibilities?',
    description:
      'Participatory, speculative, and prototype-based inquiries can explore alternative ways of relating to technology, contributing both design knowledge and postphenomenological understanding.',
  },
];
---

<Base
  title="Research & Publications"
  description="Peng Lu’s research on situated human–technology relations: postphenomenology, design inquiry, research resources, and selected publications."
>
  <main>
    <div class="mx-auto w-full max-w-screen-xl px-6">
      <section class="pt-[var(--navbar-height)] max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-500">
          Research & Publications
        </p>
        <h1 class="mt-5 text-4xl font-semibold leading-tight tracking-tight md:text-6xl">
          Situated human–technology relations in design research.
        </h1>
        <p class="mt-8 max-w-3xl text-xl leading-relaxed text-primary-700 md:text-2xl">
          I bring postphenomenology and design research into dialogue to understand situated
          human–technology relations and develop ways of designing for the experiences they mediate.
          Drawing on technological mediation theory, I develop concepts, methods, and tools through
          empirical, philosophical, and design inquiry.
        </p>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-primary-700">
          My work engages with more-than-human design while attending closely to lived human experience.
          I use phenomenological interviews, experience sampling, qualitative analysis, and conceptual
          and interactive research tools, adapting methods as new inquiries require.
        </p>
      </section>

      <section id="current-research" class="mt-20 scroll-mt-28 border-t border-black/10 pt-10 md:mt-28" aria-labelledby="current-research-heading">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-500">Research foundations & ongoing work</p>
        <h2 id="current-research-heading" class="mt-3 text-2xl font-semibold md:text-3xl">Research contributions & current inquiries</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <article class="rounded-3xl bg-black/5 p-7 md:p-9">
            <p class="text-sm text-primary-500">Doctoral research · 2021–2025</p>
            <h3 class="mt-4 text-2xl font-semibold">Co-driving pleasure in context</h3>
            <p class="mt-4 leading-relaxed text-primary-700">
              My PhD connected technological mediation theory with pleasure and psychological needs
              to examine how drivers experience cooperation with automated vehicles. The first study
              combined over 110 trip reports with interviews involving 12 participants; interviews with
              10 additional participants refined the interpretation. I developed the Human–Vehicle
              Relation framework and Co-Driving Pleasure Model, then discussed their design relevance
              and practical limits with nine automotive practitioners.
            </p>
            <a href="/portfolio/co-driving-pleasure/" class="mt-5 inline-flex text-sm font-semibold underline decoration-black/25 underline-offset-4 hover:decoration-black">Explore the doctoral research ↗</a>
          </article>
          <article class="rounded-3xl bg-black/5 p-7 md:p-9">
            <p class="text-sm text-primary-500">Concepts & research resources</p>
            <h3 class="mt-4 text-2xl font-semibold">Making mediation visible and discussable</h3>
            <p class="mt-4 leading-relaxed text-primary-700">
              My sole-authored NordiCHI 2026 paper introduces mediation granularity and the Mediation
              Composition Diagram (MCD), making analytical boundaries and the composition of mediated
              experience explicit. Thing-sona, developed from my doctoral work, uses cards to express
              perceived technological roles and relational qualities. Interactive prototypes extend both
              resources; new empirical cases will examine their value and limitations.
            </p>
            <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold">
              <a href="/portfolio/mediation-composition-diagram/" class="underline decoration-black/25 underline-offset-4 hover:decoration-black">Explore MCD ↗</a>
              <a href="/portfolio/thing-sona/" class="underline decoration-black/25 underline-offset-4 hover:decoration-black">Explore Thing-sona ↗</a>
            </div>
          </article>
          <article class="rounded-3xl bg-black/5 p-7 md:p-9">
            <p class="text-sm text-primary-500">Interdisciplinary foundations</p>
            <h3 class="mt-4 text-2xl font-semibold">Service, systems & human factors</h3>
            <p class="mt-4 leading-relaxed text-primary-700">
              My wider publications span a service-design framework for servitization, reflexivity across
              scales in sociotechnical transitions, systemic and speculative approaches to automated
              shuttle design, and vibrotactile takeover evaluation. These projects connect conceptual,
              design-oriented, and empirical research, informing my attention to organizational and
              sociotechnical circumstances.
            </p>
          </article>
          <article class="rounded-3xl bg-black/5 p-7 md:p-9">
            <p class="text-sm text-primary-500">Current inquiries</p>
            <h3 class="mt-4 text-2xl font-semibold">Creative practice & research methods</h3>
            <p class="mt-4 leading-relaxed text-primary-700">
              I am documenting my own AI-assisted programming and design practice to examine how
              creative practices and experiences of control and agency evolve over time. Planned
              interviews with other practitioners will extend and challenge these interpretations.
              Alongside this inquiry, I am reviewing postphenomenology’s contributions to HCI and
              design research across empirical analysis, methods, knowledge, and intervention.
            </p>
          </article>
        </div>
      </section>

      <section id="research-interests" class="mt-20 scroll-mt-28 border-t border-black/10 pt-10 md:mt-28" aria-labelledby="research-interests-heading">
        <h2 id="research-interests-heading" class="text-2xl font-semibold md:text-3xl">Research interests & guiding questions</h2>
        <p class="mt-4 max-w-3xl leading-relaxed text-primary-700">Three interconnected questions link empirical understanding, research-resource development, and design exploration. They inform one another rather than defining separate research tracks.</p>
        <div class="mt-8 grid gap-px overflow-hidden rounded-3xl border border-black/10 bg-black/10 md:grid-cols-3">
          {interests.map((interest) => (
            <article class="bg-white p-7 md:p-8">
              <span class="text-sm text-primary-500">{interest.number}</span>
              <h3 class="mt-8 text-xl font-semibold">{interest.title}</h3>
              <p class="mt-3 leading-relaxed text-primary-700">{interest.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="future-research" class="mt-20 rounded-3xl bg-primary-900 p-8 text-primary-50 md:mt-28 md:p-12" aria-labelledby="future-research-heading">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-300">Future research agenda</p>
        <h2 id="future-research-heading" class="mt-4 max-w-3xl text-2xl font-semibold leading-snug md:text-4xl">
          Connecting empirical, philosophical, and design inquiry.
        </h2>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-primary-200">
          My long-term ambition is to advance design theory and methods for understanding and
          designing for human experience amid evolving human–technology entanglements.
        </p>
        <p class="mt-4 max-w-3xl leading-relaxed text-primary-200">
          Next, I plan to extend the AI-mediated practice inquiry through interviews and practice
          diaries; develop MCD and Thing-sona through participatory inquiry into differing
          interpretations; and explore alternative relations through scenarios, prototypes, and
          guided enactments. These are proposed inquiries: their findings will revise the resources
          and generate further questions, not simply validate existing tools.
        </p>
      </section>

      <section id="publications" class="mb-20 mt-20 scroll-mt-28 border-t border-black/10 pt-10 md:mb-28 md:mt-28">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-500">Selected output</p>
            <h2 class="mt-3 text-2xl font-semibold md:text-3xl">Publications</h2>
          </div>
          <div class="flex flex-wrap gap-4">
            {researchProfiles.map((profile) => (
              <a
                href={profile.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-semibold underline decoration-black/25 underline-offset-4 hover:decoration-black"
              >
                {profile.label}
                <Icon name="material-symbols:open-in-new-rounded" size={16} />
              </a>
            ))}
          </div>
        </div>

        <ol class="mt-8 divide-y divide-black/10 border-y border-black/10">
          {publications.map((publication) => (
            <li>
              <div class="group grid gap-4 py-7 md:grid-cols-[6rem_1fr_auto] md:items-start md:gap-8">
                <div class="text-sm text-primary-500">{publication.year}</div>
                <div>
                  {publication.url ? (
                    <h3 class="text-lg font-semibold leading-snug">
                      <a
                        href={publication.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:underline hover:underline-offset-4"
                      >
                        {publication.title}
                      </a>
                    </h3>
                  ) : (
                    <h3 class="text-lg font-semibold leading-snug">{publication.title}</h3>
                  )}
                  <p class="mt-2 text-sm leading-relaxed text-primary-700">{publication.authors}</p>
                  <p class="mt-1 text-sm italic text-primary-500">{publication.venue}</p>
                </div>
                <span class="w-fit rounded-full border border-black/15 px-3 py-1 text-xs text-primary-700">
                  {publication.type}
                </span>
              </div>
            </li>
          ))}
        </ol>
      </section>

    </div>
  </main>
</Base>

---
import Base from '@/layouts/Base.astro';
import Banner from '@/components/Banner.astro';
import { useTranslations, type LanguageKey } from '@/i18n/i18n.ts';

const currentLocale: LanguageKey = 'en';
const t = useTranslations(currentLocale);
---

<Base title={t('Navbar-1')}>
  <main class="md:min-h-screen min-h-auto">
    <Banner>
      <h1 class="px-4 font-semibold">
        <span class="block text-3xl md:text-6xl leading-tight">
          {t('Hero-1', { name: t('Me-1') })}
        </span>

        <span class="block mt-4 md:mt-6 text-3xl md:text-6xl leading-tight">
          {t('Hero-2')}
        </span>

<span class="block mt-6 md:mt-8 text-2xl md:text-6xl font-light text-primary-900/70">
  {t('Hero-3')}
</span>


      </h1>

      <nav class="mt-10 flex flex-wrap gap-x-8 gap-y-4 px-4" aria-label="Explore Peng Lu's work">
        <a class="highlight isolate text-xl font-semibold md:text-2xl" href="/portfolio">
          Portfolio
        </a>
        <a class="highlight isolate text-xl font-semibold md:text-2xl" href="/research">
          My Research
        </a>
      </nav>
    </Banner>

    <section class="mb-16 mx-4">
      <div class="h-px w-full opacity-20"></div>
    </section>
  </main>
</Base>

---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import ProjectTitle from './ProjectTitle.astro';

interface Props {
  project: CollectionEntry<'project'>;
}

const { project } = Astro.props;

// -------- data mapping --------
const title = project.data.title;
const summary = project.data.contribution || project.data.description;
const typeLabel = project.data.type ?? '';
const slug = project.id.split('/').slice(1).join('/');

const href = `/portfolio/${slug}`;

const thumbnail = project.data.thumbnail ?? null;
const thumbnailAlt = project.data.thumbnailAlt ?? title;

// icon mapping（与你在 [slug].astro 里保持一致）
const typeToIcon: Record<string, string> = {
  Research: 'material-symbols:science-outline',
  Tool: 'material-symbols:build-outline',
  Product: 'material-symbols:widgets-outline',
  Service: 'material-symbols:handshake-outline',
  Strategy: 'material-symbols:strategy',
  Prototype: 'material-symbols:biotech-outline',
  Spatial: 'material-symbols:architecture',
  Teaching: 'material-symbols:school-outline',
  Experiment: 'material-symbols:experiment-outline',
};

const typeIcon = typeToIcon[typeLabel] ?? 'material-symbols:apps';
---

<a
  href={href}
  class="
    group
    block
    rounded-3xl
    bg-white
    transition
    hover:bg-black/5
  "
>
  <!-- ---------- Thumbnail ---------- -->
  <div
    class="
      w-full
      aspect-[16/9]
      md:aspect-[16/9]
      overflow-hidden
      rounded-2xl
      bg-black/5
    "
  >
    {thumbnail &&
      (typeof thumbnail === 'string' ? (
        <img
          src={thumbnail}
          alt={thumbnailAlt}
          class="h-full w-full object-cover"
          loading="lazy"
        />
      ) : (
        <Image
          src={thumbnail}
          alt={thumbnailAlt}
          class="h-full w-full object-cover"
          loading="lazy"
        />
      ))}
  </div>


  <!-- ---------- Content ---------- -->
  <div class="px-5 py-4">
    {typeLabel && (
      <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-black/60">
        <Icon name={typeIcon} size={16} />
        <span>{typeLabel}</span>
        {project.data.year && <span>{project.data.year}</span>}
      </div>
    )}

    <h3 class="text-base font-semibold leading-snug tracking-tight">
      <ProjectTitle project={project} />
    </h3>
    {summary && (
      <p class="mt-2 text-sm leading-relaxed text-black/60">{summary}</p>
    )}
  </div>
</a>

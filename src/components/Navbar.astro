---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLocale, useTranslations, type LanguageKey } from '@/i18n/i18n.ts';
import Logo from '@/assets/logo.svg';

const t = useTranslations(Astro.currentLocale as LanguageKey);

const links = [
  { url: '/portfolio', name: t('Navbar-Portfolio'), activePath: '/portfolio' },
  { url: '/research', name: t('Navbar-Research'), activePath: '/research' },
  { url: 'https://scholar.google.com/citations?user=KaqQ8gIAAAAJ', name: t('Navbar-Publications'), activePath: null },
];

function isActiveNavItem(navItem: string | null) {
  if (!navItem) return false;
  const { pathname } = new URL(Astro.url);

  const segments = pathname.split('/').filter(Boolean);

  // Home ("/") 特判
  if (navItem === '/') {
    return segments.length === 0 || segments.length === 1;
  }

  const navSegment = (navItem.split('#')[0] ?? '').replace(/^\/|\/$/g, '');
  return segments.includes(navSegment);
}

---

<nav
  style="height: var(--navbar-height)"
  class="px-4 flex flex-row flex-wrap justify-between items-center z-50 relative container mx-auto print:hidden"
>

<a
  class="hover:bg-primary-100 p-4 -m-4 rounded-full aspect-square flex justify-center items-center transition-colors"
  href={getRelativeLocaleUrl(Astro.currentLocale || defaultLocale, '/')}
>
  <Logo class="h-8 md:h-6 w-auto" />
</a>


  <div class="flex gap-2 items-center">
    <ul class="flex gap-2">
      {
        links.map(({ url, name, activePath }) => (
          <li>
            <a
              class={`px-3 py-4 text-sm sm:px-4 sm:text-base md:px-8 rounded-full transition-colors whitespace-nowrap ${
                isActiveNavItem(activePath) ? 'bg-primary-900 text-primary-50' : 'hover:bg-primary-100'
              }`}
              href={url.startsWith('https://') || url.includes('#') ? url : getRelativeLocaleUrl(Astro.currentLocale || defaultLocale, url)}
              target={url.startsWith('https://') ? '_blank' : undefined}
              rel={url.startsWith('https://') ? 'noopener noreferrer' : undefined}
            >
              {name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

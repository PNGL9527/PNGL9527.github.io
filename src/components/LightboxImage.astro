---
const {
  src,
  alt = '',
  className = '',
  caption = '',
} = Astro.props;
---

<figure class="m-0" data-lightbox-root>
  <!-- Thumbnail -->
  <img
    src={src}
    alt={alt}
    loading="lazy"
    class={`block w-full cursor-zoom-in ${className}`}
    data-lightbox-thumb
  />

  {caption && (
    <figcaption class="mt-2 text-sm text-neutral-500">
      {caption}
    </figcaption>
  )}

  <!-- Overlay -->
  <div
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4"
    data-lightbox-overlay
  >
    <img
      src={src}
      alt={alt}
      class="max-h-[90vh] max-w-[90vw] rounded-2xl"
    />
  </div>
</figure>

<script>
  // IMPORTANT: do NOT use document.currentScript
  const root = document.querySelector('[data-lightbox-root]:last-of-type');
  if (!root) return;

  const thumb = root.querySelector('[data-lightbox-thumb]');
  const overlay = root.querySelector('[data-lightbox-overlay]');

  if (!thumb || !overlay) return;

  const open = () => {
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const close = () => {
    overlay.classList.add('hidden');
    overlay.classList.remove('flex');
    document.body.style.overflow = '';
  };

  thumb.addEventListener('click', open);
  overlay.addEventListener('click', close);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
</script>

---
const { src, alt = "", className = "", caption = "" } = Astro.props;

// 生成一个足够唯一的 id（服务于同页多张图）
const id = `lb-${Math.random().toString(36).slice(2, 10)}`;
---

<figure class="m-0" data-lightbox-root={id}>
  <!-- Thumbnail -->
  <img
    src={src}
    alt={alt}
    loading="lazy"
    class={`block w-full cursor-zoom-in ${className}`}
    data-lightbox-thumb={id}
  />

  {caption ? (
    <figcaption class="mt-2 text-sm text-neutral-500">{caption}</figcaption>
  ) : null}

  <!-- Overlay -->
  <div
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4"
    aria-hidden="true"
    data-lightbox-overlay={id}
  >
    <img
      src={src}
      alt={alt}
      class="max-h-[90vh] max-w-[90vw] rounded-2xl"
    />
  </div>
</figure>

<!-- IMPORTANT: use define:vars to pass id into the script -->
<script define:vars={{ id }}>
  (() => {
    const thumb = document.querySelector(`[data-lightbox-thumb="${id}"]`);
    const overlay = document.querySelector(`[data-lightbox-overlay="${id}"]`);

    if (!thumb || !overlay) return;

    const open = () => {
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const close = () => {
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    const onKeyDown = (e) => {
      if (e.key === "Escape") close();
    };

    thumb.addEventListener("click", open);
    overlay.addEventListener("click", close);
    document.addEventListener("keydown", onKeyDown);
  })();
</script>

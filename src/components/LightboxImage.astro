---
const { src, alt = '', className = '' } = Astro.props;
---

<div class="relative">
  <img
    src={src}
    alt={alt}
    class={`cursor-zoom-in ${className}`}
    loading="lazy"
    data-lightbox-image
  />

  <!-- overlay -->
  <div
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80"
    data-lightbox-overlay
  >
    <img
      src={src}
      alt={alt}
      class="max-h-[90vh] max-w-[90vw] rounded-xl"
    />
  </div>
</div>

<script>
  const root = document.currentScript.parentElement;
  const image = root.querySelector('[data-lightbox-image]');
  const overlay = root.querySelector('[data-lightbox-overlay]');

  image.addEventListener('click', () => {
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    document.body.style.overflow = 'hidden';
  });

  overlay.addEventListener('click', () => {
    overlay.classList.add('hidden');
    overlay.classList.remove('flex');
    document.body.style.overflow = '';
  });
</script>
